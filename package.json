{
  "name": "ltdlens",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Check any UK company before you trade — risk flags from official Companies House data.",
  "author": "Tomasz 'Amigo' Lewandowski <dev@attv.uk> (https://www.attv.uk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmigoUK/LtdLens.git"
  },
  "workspaces": [
    "shared",
    "fixtures",
    "worker",
    "extension"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:worker": "npm run dev -w worker",
    "dev:ext": "npm run dev -w extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "zip": "npm run zip -w extension",
    "verify": "node scripts/verify-workspace.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {}
}
