{
  // WXT generates .wxt/tsconfig.json with the path aliases (@/, ~/) and the
  // browser API types. Extending it is the only supported arrangement; the
  // strictness flags are re-declared because WXT owns the generated file and a
  // regeneration would otherwise drop them.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "platform/**/*.ts",
    "components/**/*.tsx",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "tests/**/*.ts",
    "wxt.config.ts",
    "vitest.config.ts"
  ]
}
