{
  "name": "@ltdlens/worker",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Caching proxy in front of the Companies House public data API, so users never need their own key.",
  "dependencies": {
    "@ltdlens/fixtures": "*",
    "@ltdlens/shared": "*"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --env-interface Env"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.115.0"
  }
}
