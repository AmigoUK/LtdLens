{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // `worker-configuration.d.ts` is generated by `npm run cf-typegen` and
    // committed, so a fresh clone typechecks without running Wrangler first.
    // `wrangler types` supersedes @cloudflare/workers-types; regenerate after
    // any change to wrangler.jsonc.
    //
    // The pool's `/types` entry is what declares the `cloudflare:test` module
    // (SELF, env, isolated storage) used by the test files.
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
